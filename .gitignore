# TacICL release: only project files are tracked (whitelist).
/*
!/.gitignore
!/.nojekyll
!/README.md
!/index.html

!/prometheus/
/prometheus/*
!/prometheus/policy/
/prometheus/policy/*
!/prometheus/policy/univtac_icl/
!/prometheus/workflows/
/prometheus/workflows/*
!/prometheus/workflows/univtac_icl.py
!/prometheus/configs/
/prometheus/configs/*
!/prometheus/configs/univtac_icl.yaml
!/prometheus/configs/univtac_icl_insert_tube.yaml

!/tests/
/tests/*
!/tests/test_univtac_icl.py

!/scripts/
/scripts/*
!/scripts/run_qwen_univtac_local.sh

!/docs/
/docs/*
!/docs/.nojekyll
!/docs/index.html
!/docs/tacicl_site/

!/data/
/data/*
!/data/reports/
/data/reports/*
!/data/reports/univtac_icl_insert_tube_20261028/

__pycache__/
*.pyc
